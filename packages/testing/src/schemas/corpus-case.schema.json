{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfence.dev/schemas/corpus-case.schema.json",
  "title": "OpenAgentFence CorpusCase 1.1",
  "type": "object",
  "required": [
    "id",
    "mode",
    "attackClasses",
    "invariants",
    "kind",
    "surfaces",
    "initiator",
    "pages",
    "task",
    "expected"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "mode": { "enum": ["attack", "benign"] },
    "attackClasses": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "A1",
          "A2",
          "A3",
          "A4",
          "A5",
          "A6",
          "A7",
          "A8",
          "A9",
          "A10",
          "A11",
          "A12",
          "A13",
          "A14",
          "A15",
          "A16",
          "A17",
          "A18",
          "A19",
          "A20"
        ]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "pattern": "^INV-(?:0[1-9]|1[0-9]|2[01])$" }
    },
    "kind": { "enum": ["static", "mutation", "adaptive-ready"] },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "dom",
          "hidden-dom",
          "aria",
          "metadata",
          "attributes",
          "comments",
          "encoding",
          "unicode",
          "cross-origin",
          "navigation",
          "network",
          "network-mutation",
          "fetch",
          "redirect",
          "form",
          "popup",
          "websocket",
          "beacon",
          "service-worker",
          "webmcp",
          "memory",
          "exfiltration",
          "upload",
          "download",
          "message",
          "paste",
          "guard-provider",
          "semantic-guard",
          "screenshot",
          "file"
        ]
      }
    },
    "initiator": {
      "enum": [
        "none",
        "agent",
        "page-script",
        "form",
        "redirect",
        "webmcp",
        "service-worker",
        "unknown"
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "pattern": "^/", "maxLength": 2048 },
          "origin": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$", "maxLength": 32 }
        }
      }
    },
    "task": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "taskContract": { "$ref": "#/$defs/jsonObject" },
    "policy": { "$ref": "#/$defs/jsonObject" },
    "steps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "action": { "type": "string", "minLength": 1, "maxLength": 128 },
          "target": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "mutation": {
      "type": "object",
      "required": ["trigger"],
      "additionalProperties": false,
      "properties": {
        "trigger": { "enum": ["load", "timer", "action", "navigation", "request"] },
        "target": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "sequence": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "adaptive": {
      "type": "object",
      "required": ["seed", "transformations", "maxVariants"],
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "string", "minLength": 1, "maxLength": 256 },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "maxVariants": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": ["ALLOW", "ALLOW_SANITIZED", "WARN", "RESTRICT", "BLOCK", "QUARANTINE"]
        },
        "reasons": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "risk": { "enum": ["NORMAL", "RESTRICTED", "READ_ONLY", "QUARANTINED"] },
        "control": {
          "enum": [
            "deterministic",
            "semantic-evidence-only",
            "approval",
            "observed-only",
            "unavailable"
          ]
        }
      }
    },
    "locale": { "type": "string", "minLength": 1, "maxLength": 64 },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "attack" } } },
      "then": { "properties": { "attackClasses": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "mode": { "const": "benign" } } },
      "then": { "properties": { "attackClasses": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "mutation" } } },
      "then": { "required": ["mutation"], "not": { "required": ["adaptive"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "adaptive-ready" } } },
      "then": { "required": ["adaptive"], "not": { "required": ["mutation"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "static" } } },
      "then": { "not": { "anyOf": [{ "required": ["mutation"] }, { "required": ["adaptive"] }] } }
    }
  ],
  "$defs": {
    "jsonObject": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "maxLength": 128,
        "not": {
          "pattern": "^(?:__proto__|prototype|constructor|exec|generator|code|script|require|module|import)$"
        }
      },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "jsonValue": {
      "anyOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/jsonObject" }
      ]
    }
  }
}
