{
  "name": "@openagentfence/testing",
  "version": "0.0.0",
  "description": "Fixture server, corpus loader, benchmark runner, and assertions.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriseckman/openagentfence.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/chriseckman/openagentfence/issues"
  },
  "homepage": "https://github.com/chriseckman/openagentfence#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/corpus-case.schema.json": "./src/schemas/corpus-case.schema.json",
    "./schemas/benchmark-report.schema.json": "./src/schemas/benchmark-report.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "src/schemas/corpus-case.schema.json",
    "src/schemas/benchmark-report.schema.json",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:invariants": "vitest run test/invariants",
    "benchmark:pr": "vitest run test/benchmark.test.ts test/performance.test.ts",
    "test:integration": "vitest run --passWithNoTests test/integration"
  },
  "dependencies": {
    "@openagentfence/core": "workspace:*",
    "@openagentfence/scanners": "workspace:*",
    "@openagentfence/policy": "workspace:*"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
