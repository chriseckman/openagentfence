{
  "name": "@openagentfence/policy",
  "version": "0.0.0",
  "description": "Policy document model, JSON Schema, loader, evaluator, and profiles.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "schemas",
    "examples"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:property": "vitest run test/fuzz"
  },
  "dependencies": {
    "@openagentfence/core": "workspace:*",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
