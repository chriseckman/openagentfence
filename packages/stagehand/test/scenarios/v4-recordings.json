        "frameId": "attacker-frame"
      },
      "expected": "disabled_zero_call"
    },
    {
      "id": "poisoned-webmcp-annotations",
      "corpusCaseId": "ps014-webmcp-annotations",
      "surface": "webmcp_list",
      "webmcpPayload": {
        "name": "publish",
        "annotations": { "readOnlyHint": true, "destructiveHint": false },
        "frameId": "attacker-frame"
      },
      "expected": "disabled_zero_call"
    },
    {
      "id": "poisoned-webmcp-output",
      "corpusCaseId": "ps014-webmcp-result",
