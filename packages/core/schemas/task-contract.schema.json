{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openagentfence.dev/schemas/task-contract.schema.json",
  "title": "OpenAgentFence TaskContract",
  "type": "object",
  "required": ["task"],
  "additionalProperties": false,
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigation": { "enum": ["same-site", "same-origin", "allowlist", "none"] },
        "downloads": { "type": "boolean" },
        "uploads": { "type": "boolean" },
        "purchases": { "type": "boolean" },
        "messaging": { "type": "boolean" },
        "destructiveActions": { "type": "boolean" },
        "credentials": { "type": "boolean" },
        "executeScript": { "type": "boolean" },
        "privateNetwork": { "type": "boolean" },
        "externalCommunication": { "type": "boolean" }
      }
    },
    "secrets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name", "kind", "origins", "fieldTypes"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
          "kind": { "enum": ["SECRET", "PII", "CREDENTIAL"] },
          "origins": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "format": "uri" }
          },
          "fieldTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
          },
          "selector": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "formAction": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "origins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "block": { "type": "array", "items": { "type": "string" } }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxActions": { "type": "number", "minimum": 0 },
        "maxDurationMs": { "type": "number", "minimum": 0 },
        "maxNavigations": { "type": "number", "minimum": 0 },
        "maxRedirectHops": { "type": "number", "minimum": 0 },
        "maxGuardCalls": { "type": "number", "minimum": 0 },
        "maxGuardTokens": { "type": "number", "minimum": 0 },
        "maxDownloads": { "type": "number", "minimum": 0 },
        "maxDownloadBytes": { "type": "number", "minimum": 0 },
        "maxUploadBytes": { "type": "number", "minimum": 0 },
        "maxTabs": { "type": "number", "minimum": 0 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "timeoutMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
