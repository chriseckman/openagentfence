{
  "name": "@openagentfence/core",
  "version": "0.0.0",
  "description": "Core contracts, orchestrator, guards, risk, taint, secrets, trace, and probe.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chriseckman/openagentfence.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/chriseckman/openagentfence/issues"
  },
  "homepage": "https://github.com/chriseckman/openagentfence#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "README.md",
    "schemas",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --coverage",
    "test:property": "vitest run test/property"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6"
  }
}
